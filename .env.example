# Copy this file to .env and fill in your credentials

# OpenAI API (for AI trade explanations — optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Telegram Bot (for trade alerts — optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP (for email alerts — optional, works with Gmail App Passwords)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
